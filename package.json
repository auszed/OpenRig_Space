{
  "name": "backoffice-agents",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run --cwd apps/office build",
    "start": "bun packages/server/src/index.ts",
    "start:mock": "BACKOFFICE_SOURCE=mock bun packages/server/src/index.ts",
    "dev:server": "bun --watch packages/server/src/index.ts",
    "dev:web": "bun run --cwd apps/office dev",
    "test": "bun test",
    "check": "bun run --cwd apps/office check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "bun": "1.4.4",
    "typescript": "^5.9.0"
  }
}
